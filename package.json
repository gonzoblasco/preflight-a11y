{
  "name": "preflight-a11y",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "The pre-launch gate for AI-built websites: what a screen reader actually announces, and the fix prompt your builder can execute.",
  "license": "MIT",
  "keywords": [
    "accessibility",
    "a11y",
    "screen-reader",
    "wcag",
    "axe",
    "ci",
    "ai",
    "lovable",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gonzoblasco/preflight.git"
  },
  "bin": {
    "preflight": "./scripts/cli.js"
  },
  "files": [
    "scripts/cli.js",
    "src/lib",
    "action.yml"
  ],
  "scripts": {
    "dev": "next dev -p 4317",
    "build": "next build",
    "start": "next start -p 4317",
    "test": "vitest run",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "cli": "tsx scripts/cli.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@guidepup/virtual-screen-reader": "0.32.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axe-core": "4.14.0",
    "jsdom": "30.0.1",
    "next": "16.4.5",
    "playwright": "1.64.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.0.8"
  },
  "engines": {
    "node": ">=22"
  }
}
